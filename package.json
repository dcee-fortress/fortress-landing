{
  "name": "qs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/clean-dev-lock.mjs",
    "dev": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev --turbopack",
    "dev:turbopack": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev --turbopack",
    "dev:webpack": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next dev --webpack",
    "build": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build --webpack",
    "start": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.7",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^1.6.7",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "^7.10.0",
    "tailwindcss": "^4"
  }
}
