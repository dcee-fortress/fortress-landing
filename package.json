    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@vercel/blob": "^2.8.0",
    "better-sqlite3": "^13.0.3",
    "fflate": "^0.8.3",
    "heic2any": "^0.0.4",
    "html2canvas": "^1.4.1",
    "html2canvas-pro": "^1.6.7",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "unpdf": "^2.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/cli": "^8.6.3",
    "@serwist/next": "^9.6.0",
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
