# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# localhost read-only sync cache
data/local-sync.db
data/*.sqlite

# runtime shared project data (seed file stays committed)
data/grove-shared-storage.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Serwist / PWA generated service worker
/public/sw.js
/public/swe-worker-*.js
/public/workbox-*.js

# Capacitor native project local artifacts
/android/.gradle
/android/app/build
/android/build
/android/captures
/android/local.properties
/ios/App/Pods
/ios/App/Podfile.lock
