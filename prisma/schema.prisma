generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Live shared Grove payload. Runtime server store uses `pg`; this schema documents the table.
model GroveSharedStorage {
  storageKey   String   @id @map("storage_key")
  storageValue String   @map("storage_value") @db.Text
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("grove_shared_storage")
}
